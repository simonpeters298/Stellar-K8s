{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "ContractWASM custom resource",
  "properties": {
    "spec": {
      "type": "object",
      "required": [
        "rpcUrl",
        "wasmUri",
        "wasmLedgerKeyXdr",
        "sha256",
        "uploadTransactionXdr"
      ],
      "properties": {
        "rpcUrl": {
          "type": "string",
          "format": "uri"
        },
        "wasmUri": {
          "type": "string",
          "format": "uri"
        },
        "wasmLedgerKeyXdr": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "uploadTransactionXdr": {
          "type": "string",
          "minLength": 1,
          "description": "Signed Soroban transaction envelope for uploading this WASM."
        }
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "Pending",
            "Submitted",
            "Ready",
            "Failed"
          ]
        },
        "wasmHash": {
          "type": "string"
        },
        "transactionHash": {
          "type": "string"
        },
        "lastError": {
          "type": "string"
        }
      }
    },
    "apiVersion": {
      "type": "string",
      "enum": [
        "stellar.org/v1alpha1"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "ContractWASM"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "spec",
    "apiVersion",
    "kind",
    "metadata"
  ],
  "additionalProperties": true,
  "x-kubernetes-group-version-kind": [
    {
      "group": "stellar.org",
      "version": "v1alpha1",
      "kind": "ContractWASM"
    }
  ]
}
