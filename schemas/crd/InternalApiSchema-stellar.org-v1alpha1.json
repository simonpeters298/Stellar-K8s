{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "description": "InternalApiSchema custom resource",
  "properties": {
    "spec": {
      "type": "object",
      "required": [
        "subject",
        "schemaVersion",
        "registryPath"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "schemaVersion": {
          "type": "integer",
          "minimum": 1
        },
        "registryPath": {
          "type": "string",
          "minLength": 1
        },
        "enforceCompatibility": {
          "type": "boolean",
          "default": true
        },
        "consumers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "clientReference"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "clientReference": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "status": {
      "type": "object",
      "properties": {
        "phase": {
          "type": "string",
          "enum": [
            "Pending",
            "Verified",
            "Rejected"
          ]
        },
        "compatibilityVerified": {
          "type": "boolean"
        },
        "impactReport": {
          "type": "string"
        }
      }
    },
    "apiVersion": {
      "type": "string",
      "enum": [
        "stellar.org/v1alpha1"
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "InternalApiSchema"
      ]
    },
    "metadata": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "spec",
    "apiVersion",
    "kind",
    "metadata"
  ],
  "additionalProperties": true,
  "x-kubernetes-group-version-kind": [
    {
      "group": "stellar.org",
      "version": "v1alpha1",
      "kind": "InternalApiSchema"
    }
  ]
}
